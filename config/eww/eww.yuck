(deflisten workspace "bash ./scripts/workspaces.sh")
(defpoll time :interval "10s" "date '+%H:%M'")

; BAR
(defwidget bar []
  (centerbox :orientation "h"
    (left)
    (center)
    (right)
  )
)

(defwidget left []
  (box :class "left"
       :orientation "h"
       :space-evenly false
       :halign "start"
    (clock)
  )
)

(defwidget center []
  (box :class "sidestuff" 
      :orientation "h" 
      :space-evenly false 
      :halign "center"
    (workspaces)
))

(defwidget right []
  (box :class "sidestuff" 
      :orientation "h" 
      :space-evenly false 
      :halign "end"
   (systemtray)
   (powerbutton)
))

(defwidget workspaces []
  (literal :content workspace)
)

(defwidget systemtray []
  (box :orientation "h" :class "tray" :halign "center"
    (systray :orientation  "h" :icon-size 15 :spacing 10)
  )
)

(defwidget clock []
	(box :orientation "v" :halign "center"
		(label :class "time" :halign "center" :text time)
	)
)

(defwidget powerbutton []
	(box :orientation "v" :halign "center"
    (button :class "powerbutton" :onclick "eww active-windows | grep -q 'powermenu' && eww close powermenu || eww open powermenu" "⏻")
  )
)

; POWER MENU V2
(defwidget powermenu []
  (box :orientation "v"
    :space-evenly false
    :spacing 25
    :valign "center"
    :halign "center"
    (powermenuitems)
    (box :class "powermenuclose"
      :orientation "h"
      :space-evenly false
      :halign "center"
      :spacing 30

      (button :onclick "eww close powermenu" " Close")
    )
  )
)

(defwidget powermenuitems []
  (box :class "powermenuitems"
    :orientation "h"
    :space-evenly false
    :halign "center"
    :spacing 30
    (button :onclick "shutdown -h 0" "")
    (button :onclick "reboot" "")
    (button :onclick "i3-msg exit" "󰗽")
  )
)

; CUSTOM WINDOWS
(defwindow bar
  :monitor 0
  :windowtype "dock"
  :stacking "fg" 
  :focusable "false"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "50px"
                      :anchor "top center"
                    )
  :reserve (struts :side "top" :distance "4%")
  (bar)
)

(defwindow powermenu
  :monitor 0
  :windowtype "dock"
  :exclusive false
  :geometry (geometry
                      :x "0px"   
                      :y "0px"
                      :width "100%"
                      :height "100%"
                      :anchor "top left"
            )
  :wm-ignore true
  (powermenu)
)